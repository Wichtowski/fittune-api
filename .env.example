# Environment variables for fittune-api.
# Copy to .env for local development. Production values live in the
# ENV_PRODUCTION GitHub Actions secret and are written to .env on the VPS.

# --- Database ---
# Local: matches docker-compose.yml. Production: the fittune-postgres service.
FITTUNE_DATABASE_URL=postgres://fittune:fittune@localhost:5432/fittune
FITTUNE_DB_MAX_CONNECTIONS=10

# Only read by docker-compose.prod.yml to initialise the Postgres container.
POSTGRES_USER=fittune
POSTGRES_PASSWORD=fittune
POSTGRES_DB=fittune

# --- HTTP ---
FITTUNE_BIND_ADDR=0.0.0.0:4733
# Comma-separated browser origins allowed to call the API.
FITTUNE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth ---
# Bearer sessions slide forward on use and expire after this many idle hours.
FITTUNE_SESSION_TTL_HOURS=720

# --- Observability ---
# pretty | json
FITTUNE_LOG_FORMAT=pretty
# tracing filter, e.g. fittune_api=debug,tower_http=debug
FITTUNE_LOG=fittune_api=info,tower_http=info,sqlx=warn,info
FITTUNE_APP_VERSION=dev

# --- Local integration tests (sqlx::test) ---
DATABASE_URL=postgres://fittune:fittune@localhost:5432/fittune

# --- Docker Host Port Bindings (development compose only) ---
FITTUNE_POSTGRES_PORT=5432
FITTUNE_API_PORT=4733
