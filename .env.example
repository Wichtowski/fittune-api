# Environment variables for fittune-api.
# Copy to .env for local development. Production values live in the
# ENV_PRODUCTION GitHub Actions secret and are written to .env on the VPS.

# --- Database ---
# Local: matches docker-compose.yml. Production: the fittune-postgres service.
FITTUNE_DATABASE_URL=postgres://fittune:fittune@localhost:5432/fittune
FITTUNE_DB_MAX_CONNECTIONS=10

# Only read by docker-compose.prod.yml to initialise the Postgres container.
POSTGRES_USER=fittune
POSTGRES_PASSWORD=fittune
POSTGRES_DB=fittune

# --- HTTP ---
FITTUNE_BIND_ADDR=0.0.0.0:4733
# Comma-separated browser origins allowed to call the API.
# The app runs on http://fittune.local:4734 locally (see fittune-app's README for /etc/hosts)
FITTUNE_CORS_ORIGINS=http://fittune.local:4734,http://localhost:4734,http://127.0.0.1:4734

# --- Auth ---
# Bearer sessions slide forward on use and expire after this many idle hours.
FITTUNE_SESSION_TTL_HOURS=720

# --- Registration ---
# Production uses the default, invite_only. Open lets anyone sign up; for local development only
FITTUNE_REGISTRATION=open
# Header with the client IP from a trusted proxy (X-Real-IP in production); unset locally
FITTUNE_CLIENT_IP_HEADER=

# --- Observability ---
# pretty | json
FITTUNE_LOG_FORMAT=pretty
# tracing filter, e.g. fittune_api=debug,tower_http=debug
FITTUNE_LOG=fittune_api=info,tower_http=info,sqlx=warn,info
FITTUNE_APP_VERSION=dev

# --- Private progress photos (RustFS S3 API) ---
FITTUNE_PHOTOS_ENDPOINT=http://localhost:9000
FITTUNE_PHOTOS_BUCKET=fittune-progress-photos
FITTUNE_PHOTOS_ACCESS_KEY=fittunelocal
FITTUNE_PHOTOS_SECRET_KEY=fittune-local-secret-change-me
FITTUNE_RUSTFS_PORT=9000

# --- Local development fixtures (make seed; dev builds only) ---
# seed-dev refuses to run unless this is `development`. Never set it in production
FITTUNE_ENV=development
# Dedicated fixture database, separate from the test DATABASE_URL below. It must be on localhost
# and end in _dev; `make seed` creates it and `make run-fixtures` serves it
FITTUNE_FIXTURES_DATABASE_URL=postgres://fittune:fittune@localhost:5432/fittune_dev
# Day the fixture history counts back from (YYYY-MM-DD); empty means today
FITTUNE_FIXTURES_BASE_DATE=

# --- Local integration tests (sqlx::test) ---
DATABASE_URL=postgres://fittune:fittune@localhost:5432/fittune

# --- Docker Host Port Bindings (development compose only) ---
FITTUNE_POSTGRES_PORT=5432
FITTUNE_API_PORT=4733
